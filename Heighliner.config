dockerfile "Dockerfile"

# API_BASE_URL is read by Config.j.erb. It assumes the backend in ../backend
# was initialised as `heighliner init manabe`; change it if yours differs.
app_params "
  -e CHROME_HOSTNAME=<%= @config[:shared_names][:chrome] %>
  -e TEST_HOST=<%= app_container_name %>
  -e API_BASE_URL=https://manabe.<%= http_suffix %>/api/v1
"

expose "4444"

# `heighliner up -a` / `attach` only: the project is mounted over the copy in
# the image, so chino serves the files as they are on disk and a browser
# refresh shows an edit, with no rebuild. Without -a the container keeps the
# copy from its last build.
attach_mount '.', '/app'

type :http
