#!/bin/bash
# Builds the Ruby runtime: mruby compiled to WebAssembly with Emscripten.
# Writes mruby.js and mruby.wasm to Resources/runtimes/ruby/, which are
# committed, so the app's build and tests do not need Emscripten.
#
#   runtimes/mruby/build              # from the repository root
#
# Needs git, a C compiler, bison and Ruby with rake. Emscripten is installed
# into the work directory if emcc is not on PATH. See docs/runtimes.md.
set -euo pipefail

MRUBY_VERSION=3.4.0
EMSDK_VERSION=6.0.12

here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../.." && pwd)
# Outside the repository: chino compiles every .j file in the tree, and the
# Docker image copies all of it.
work=${WORK_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/manabase-mruby}
out=$root/Resources/runtimes/ruby
mkdir -p "$work" "$out"

if ! command -v emcc >/dev/null; then
  if [ ! -d "$work/emsdk" ]; then
    git clone --depth 1 https://github.com/emscripten-core/emsdk "$work/emsdk"
  fi
  "$work/emsdk/emsdk" install "$EMSDK_VERSION"
  "$work/emsdk/emsdk" activate "$EMSDK_VERSION" >/dev/null
  # shellcheck disable=SC1091
  source "$work/emsdk/emsdk_env.sh" >/dev/null 2>&1
fi
echo "emcc: $(emcc --version | head -1)"

if [ ! -d "$work/mruby" ]; then
  git clone --depth 1 --branch "$MRUBY_VERSION" https://github.com/mruby/mruby "$work/mruby"
fi

(cd "$work/mruby" && MRUBY_CONFIG="$here/build_config.rb" rake -j"$(nproc 2>/dev/null || echo 4)")

config="$work/mruby/build/emscripten/host-bin/mruby-config"
# mruby compiles with -g; linking with it would put DWARF into the .wasm and
# make it five times larger.
cflags=$("$config" --cflags | sed 's/ -g / /')

# shellcheck disable=SC2046,SC2086
emcc -Oz $cflags "$here/runner.c" $("$config" --ldflags --libs) \
  -sMODULARIZE=1 -sEXPORT_NAME=createMruby -sENVIRONMENT=worker,node \
  -sALLOW_MEMORY_GROWTH=1 -sSTACK_SIZE=1048576 \
  -sEXPORTED_FUNCTIONS=_manabase_run -sEXPORTED_RUNTIME_METHODS=ccall \
  -o "$out/mruby.js"

cp "$work/mruby/LICENSE" "$out/LICENSE"

ls -l "$out/mruby.js" "$out/mruby.wasm"
