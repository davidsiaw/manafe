#!/bin/bash
#
# Runs the browser specs. The specs serve the app themselves, together with a
# mock backend (tests/spec_helper.rb), so no chino needs to be running.

set -uo pipefail
cd "$(dirname "$0")/.."

: "${CHROME_HOSTNAME:?CHROME_HOSTNAME must be set (Selenium Grid host)}"
: "${TEST_HOST:?TEST_HOST must be set (this host, as seen from chrome)}"

export BUNDLE_GEMFILE="$PWD/tests/Gemfile"
bundle check > /dev/null 2>&1 || bundle install

RSPEC_OPTS=(-I tests --require spec_helper --format documentation --color)
if [ "$#" -eq 0 ]; then
  bundle exec rspec "${RSPEC_OPTS[@]}" tests/spec
else
  bundle exec rspec "${RSPEC_OPTS[@]}" "$@"
fi
