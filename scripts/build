#!/bin/bash

set -uo pipefail
cd "$(dirname "$0")/.."

# The Zig runtime is built, not committed (runtimes/zig/build).
if [ ! -f Resources/runtimes/zig/zig.wasm ]; then
  echo "build: the Zig runtime is not built; run runtimes/zig/build first" >&2
  exit 1
fi

# chino compiles every .j file except under hidden paths, and tests/unit
# would break the build, so hide tests/ until the script exits.
STASH=".tests-stashed-by-build"
if [ -e "$STASH" ]; then
  echo "build: $STASH exists from an interrupted run; move it back to tests/ first" >&2; exit 1
fi
if [ -d tests ]; then
  mv tests "$STASH"
  trap 'mv "$STASH" tests' EXIT
fi

# chino exits 0 even when compilation fails.
LOG=$(mktemp)
BUNDLE_GEMFILE="$PWD/Gemfile" bundle exec chino build 2>&1 | tee "$LOG"
status=${PIPESTATUS[0]}

if [ "$status" -ne 0 ]; then
  echo "build: chino build exited $status" >&2; exit 1
fi
if grep -qE '^ERROR |TypeError' "$LOG"; then
  echo 'build: compiler reported errors:' >&2
  grep -E '^ERROR |TypeError' "$LOG" >&2
  exit 1
fi
if [ ! -f build/index.html ] || [ ! -d build/Browser.environment ]; then
  echo 'build: build/ is missing index.html or Browser.environment' >&2; exit 1
fi
echo 'build: ok'
